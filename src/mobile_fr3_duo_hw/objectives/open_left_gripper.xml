<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Open Left Gripper">
  <!-- Replaces mobile_fr3_duo_mock's file: on the real robot a franka_gripper node drives each Franka Hand. -->
  <BehaviorTree
    ID="Open Left Gripper"
    _description="Open the left gripper"
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!-- The position is per finger. franka_gripper moves to twice this width. -->
      <Action
        ID="MoveGripperAction"
        gripper_command_action_name="/left/franka_gripper/gripper_action"
        position="0.035"
        timeout="10.000000"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Open Left Gripper">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Grasping" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

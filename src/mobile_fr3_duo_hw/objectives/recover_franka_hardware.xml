<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Recover Franka Hardware">
  <BehaviorTree
    ID="Recover Franka Hardware"
    _description="Clear a reflex or error on one Franka device (an arm or the base), then restore its hardware component and the broadcasters. Motion controllers stay inactive until an Objective activates them."
  >
    <Control ID="Sequence" name="root">
      <Action
        ID="FrankaErrorRecovery"
        action_name="{error_recovery_action}"
        timeout="{recovery_timeout}"
      />
      <!-- The fault normally takes the component out of active already, so this step can fail. -->
      <Decorator ID="ForceSuccess">
        <Action
          ID="SetHardwareComponentState"
          hardware_name="{hardware_name}"
          target_state="inactive"
          timeout="10.0"
        />
      </Decorator>
      <Action
        ID="SetHardwareComponentState"
        hardware_name="{hardware_name}"
        target_state="active"
        timeout="10.0"
      />
      <!-- joint_state_broadcaster reads every device, so a fault on any one deactivates it. -->
      <Action
        ID="SwitchController"
        activate_controllers="{broadcasters}"
        strictness="2"
        activate_asap="true"
        timeout="10.0"
      />
      <Action ID="LogMessage" log_level="info" message="Recovery complete." />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Recover Franka Hardware">
      <MetadataFields>
        <Metadata subcategory="Franka" />
        <Metadata runnable="false" />
      </MetadataFields>
      <inout_port
        name="error_recovery_action"
        default="/left/action_server/error_recovery"
        type="std::string"
      >
        The franka_ros2 error_recovery action of the device. An arm's is under
        its side's namespace; the base's has no namespace.
      </inout_port>
      <inout_port
        name="hardware_name"
        default="left_FrankaHardwareInterface"
        type="std::string"
      >
        The device's ros2_control hardware component, named in
        description/mobile_fr3_duo_hw.ros2_control.xacro.
      </inout_port>
      <inout_port
        name="broadcasters"
        default="joint_state_broadcaster;left_franka_robot_state_broadcaster"
        type="std::vector&lt;std::string&gt;"
      >
        The broadcasters to activate again.
      </inout_port>
      <inout_port name="recovery_timeout" default="15.0" type="double">
        Seconds to wait for the device to clear its fault.
      </inout_port>
    </SubTree>
  </TreeNodesModel>
</root>

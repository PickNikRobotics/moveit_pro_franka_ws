<?xml version="1.0" ?>
<package format="3">
  <name>mobile_fr3_duo_hw</name>
  <version>10.1.0</version>

  <description>
    MoveIt Pro configuration for the real Franka Mobile FR3 Duo: two FR3 arms
    with Franka Hands, the spine and the TMR base.
  </description>

  <maintainer email="support@picknik.ai">MoveIt Pro Maintainer</maintainer>

  <license>BSD-3-Clause</license>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>franka_behaviors</exec_depend>
  <exec_depend>franka_description</exec_depend>
  <exec_depend>franka_gripper</exec_depend>
  <exec_depend>franka_hardware</exec_depend>
  <exec_depend>franka_mobile</exec_depend>
  <exec_depend>franka_robot_state_broadcaster</exec_depend>
  <exec_depend>franka_spine_msgs</exec_depend>
  <exec_depend>franka_spine_server</exec_depend>
  <exec_depend>mobile_fr3_duo_mock</exec_depend>
  <exec_depend>mobile_fr3_duo_sim</exec_depend>
  <exec_depend>moveit_pro_behavior</exec_depend>
  <exec_depend>moveit_studio_utils_py</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sick_safetyscanners2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

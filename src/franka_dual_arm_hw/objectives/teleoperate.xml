<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Right-arm teleoperation for the dual-arm config. Drives the /right namespace
  (right_manipulator, right_fr3_link8, /right/joint_trajectory_controller).
  See request_teleoperation.xml for the dual-arm namespacing notes/limitations.
-->
<root BTCPP_format="4" main_tree_to_execute="Teleoperate">
  <BehaviorTree
    ID="Teleoperate"
    _description="Right-arm teleoperation from the web UI (dual-arm config). Can be used standalone."
    _favorite="false"
  >
    <SubTree
      ID="Request Teleoperation"
      _collapsed="false"
      enable_user_interaction="false"
      user_interaction_prompt=""
      initial_teleop_mode="1"
      controller_action_server="/right/joint_trajectory_controller/follow_joint_trajectory"
      max_ik_solutions="8"
      max_mtc_solutions="1"
      joint_trajectory_controller_name="joint_trajectory_controller"
      default_planning_group="right_manipulator"
      default_ik_frame="right_fr3_link8"
      link_padding="0.01"
      execution_pipeline="jtc"
    />
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Teleoperate">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="User Input" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

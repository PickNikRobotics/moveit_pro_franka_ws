<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Dual-arm teleoperation. Uses the core "Request Teleoperation" subtree (un-namespaced)
  against the single controller_manager and the combined joint_trajectory_controller
  (all 14 joints). Starts in mode 3 (Move to Joint State), which does not read the
  {controllers} blackboard key, so no seeding is needed. The web UI's group selector
  picks left_manipulator / right_manipulator; Joint Jog (mode 1) and Cartesian Jog
  (mode 2) draw their per-arm controllers from config/moveit/joint_jog.yaml and
  config/moveit/pose_jog.yaml.
-->
<root BTCPP_format="4" main_tree_to_execute="Teleoperate">
  <BehaviorTree
    ID="Teleoperate"
    _description="Dual-arm teleoperation using the combined joint trajectory controller (JTC)"
  >
    <SubTree
      ID="Request Teleoperation"
      controller_action_server="/joint_trajectory_controller/follow_joint_trajectory"
      joint_trajectory_controller_name="joint_trajectory_controller"
      execution_pipeline="jtc"
      enable_user_interaction="false"
      initial_teleop_mode="3"
      user_interaction_prompt=""
    />
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Teleoperate">
      <MetadataFields>
        <Metadata subcategory="User Input" />
        <Metadata runnable="true" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

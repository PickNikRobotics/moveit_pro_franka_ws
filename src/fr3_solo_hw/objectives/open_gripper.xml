<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Open Gripper">
  <!-- Replaces fr3_solo_mock's file: on the real robot the franka_gripper node drives the Franka Hand. -->
  <BehaviorTree ID="Open Gripper" _description="Open the Franka Hand">
    <Control ID="Sequence" name="root">
      <!-- The position is per finger. franka_gripper moves to twice this width. -->
      <Action
        ID="MoveGripperAction"
        gripper_command_action_name="/franka_gripper/gripper_action"
        position="0.035"
        timeout="10.000000"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Open Gripper">
      <MetadataFields>
        <Metadata subcategory="Grasping" />
        <Metadata runnable="true" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

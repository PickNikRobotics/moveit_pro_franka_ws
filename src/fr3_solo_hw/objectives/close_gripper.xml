<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Close Gripper">
  <!-- Replaces fr3_solo_mock's file: on the real robot the franka_gripper node drives the Franka Hand. -->
  <BehaviorTree ID="Close Gripper" _description="Close the Franka Hand">
    <Control ID="Sequence" name="root">
      <!-- Fails if the fingers stop on an object: use Grasp Object to hold one. -->
      <Action
        ID="MoveGripperAction"
        gripper_command_action_name="/franka_gripper/gripper_action"
        position="0"
        timeout="10.000000"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Close Gripper">
      <MetadataFields>
        <Metadata subcategory="Grasping" />
        <Metadata runnable="true" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>

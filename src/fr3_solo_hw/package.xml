<?xml version="1.0" ?>
<package format="3">
  <name>fr3_solo_hw</name>
  <version>10.1.0</version>

  <description>
    MoveIt Pro configuration for one real Franka FR3 arm with a Franka Hand.
  </description>

  <maintainer email="support@picknik.ai">MoveIt Pro Maintainer</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fr3_solo_mock</exec_depend>
  <exec_depend>fr3_solo_sim</exec_depend>
  <exec_depend>franka_behaviors</exec_depend>
  <exec_depend>franka_description</exec_depend>
  <exec_depend>franka_gripper</exec_depend>
  <exec_depend>franka_hardware</exec_depend>
  <exec_depend>franka_robot_state_broadcaster</exec_depend>
  <exec_depend>moveit_pro_behavior</exec_depend>
  <exec_depend>moveit_studio_agent</exec_depend>
  <exec_depend>moveit_studio_rest_api</exec_depend>
  <exec_depend>moveit_studio_utils_py</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
